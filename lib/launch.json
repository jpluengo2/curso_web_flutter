{
    // Este archivo define configuraciones de depuración para VS Code.
    // Te permite ejecutar tu aplicación con opciones específicas
    // directamente desde la pestaña "Run and Debug" (Ctrl+Shift+D).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Curso Flutter (Chrome)",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome",
                "--web-renderer",
                "canvaskit" // Usa CanvasKit para un renderizado más consistente.
            ]
        },
        {
            "name": "Curso Flutter (Edge)",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "edge"
            ]
        }
    ]
}