{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Curso Web Flutter (Chrome)",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome",
                "--web-renderer",
                "canvaskit" // Usa CanvasKit para un renderizado más consistente.
            ]
        },
        {
            "name": "Curso Web Flutter (Chrome - Debug)",
            "request": "launch",
            "type": "dart",
            "args": ["-d", "chrome"]
        },
        {
            "name": "Curso Web Flutter (Chrome - Profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": ["-d", "chrome"]
        },
        {
            "name": "Curso Web Flutter (Chrome - Release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["-d", "chrome"]
        },
        {
            "name": "Curso Web Flutter (Edge)",
            "request": "launch",
            "type": "dart",
            "args": ["-d", "edge"]
        },
        {
            "name": "Curso Web Flutter (Current Device)",
            "request": "launch",
            "type": "dart"
        }
    ]
}